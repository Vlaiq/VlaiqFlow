# Copy to backend/.env and fill in. Never commit .env.
API_PORT=8787

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# openrouteservice (routing, matrix, geocoding) — https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Optional integrations (P2) — the app must work without them
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tiger Cloud / Postgres connection string (not needed for P0)
DATABASE_URL=
