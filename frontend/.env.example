# Copy to frontend/.env. Everything prefixed VITE_ is PUBLIC (ends up in the bundle) — no secrets here.

# Backend base URL in production, e.g. https://api.your-domain.ro
# Leave empty in development: Vite proxies /api to http://localhost:8787.
VITE_API_URL=

# Accounts: leave empty (or local) for no sign-in — each browser gets a random device ID.
# Set to auth0 to turn FLOW Identity (Auth0) back on; then the five values below are used.
VITE_FLOW_ACCOUNTS=

VITE_AUTH0_DOMAIN=dev-3a2ijpzkw4p8cng6.us.auth0.com
VITE_AUTH0_CLIENT_ID=97hHmp8qdXa5H5eVcJz3nah9uBlNjvaU
VITE_AUTH0_AUDIENCE=https://api.vlaiqflow.app
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/
VITE_AUTH0_LOGOUT_URI=http://localhost:5173/
