# Copy to backend/.env and fill in. Never commit .env.
API_PORT=8787
# Acceptance forces loopback; configure a binding for your deployment topology.
API_HOST=0.0.0.0

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# openrouteservice (routing, matrix, geocoding) — https://openrouteservice.org/dev/#/signup
# Preferred provider. If empty: driving uses the OSRM public demo, walking/cycling the FOSSGIS OSRM server (1 req/s, cached).
# In managed cloud Node 24, enable inherited proxy support with NODE_USE_ENV_PROXY=1.
ORS_API_KEY=

# Optional integrations (P2) — the app must work without them
GEMINI_API_KEY=
BUDDY_GEMINI_MODEL=gemini-3.5-flash
# Dedicated Buddy TTS voice; does not change the pinned FLOW navigation agent.
BUDDY_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_API_KEY=
# FLOW Voice uses a server-pinned agent/version and Mirela; clients cannot override them.
# The key must belong to the ElevenLabs workspace that owns the FLOW agent (shared/src/flowVoice.ts);
# a key from another account is refused and FLOW Voice says so. Restart the backend after setting it.
# Permit https://api.elevenlabs.io on the backend; WebRTC clients also need ElevenLabs/LiveKit access.
# CORS_ORIGINS must include the exact HTTPS frontend origin in production.
# HTTP navigation TTS requests use enable_logging=false; accounts without that capability fall back to browser speech.

# Durable PostgreSQL for FLOW Identity, profiles, avatars and account wallets.
# Required for account features. Run pnpm -F backend db:migrate. Use provider-required TLS.
DATABASE_URL=

# Accounts: local (default, no sign-in: X-Flow-Device header) or auth0 (JWT from Auth0).
# Must match VITE_FLOW_ACCOUNTS in frontend/.env.
FLOW_ACCOUNTS=local

AUTH0_ISSUER_BASE_URL=https://dev-3a2ijpzkw4p8cng6.us.auth0.com/
AUTH0_AUDIENCE=https://api.vlaiqflow.app

# Optional server-managed contributor fallback if native Auth0 permissions are unavailable.
# Default [] denies all fallback grants. Exact verified issuer+subject only; never email.
# This is application-managed authorization, not native Auth0 RBAC. No grant UI/API exists.
FLOW_TEAM_CONTRIBUTORS_JSON=[]
