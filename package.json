{
  "name": "vlaiq-flow",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "identity:acceptance": "node scripts/start-identity-acceptance.mjs",
    "identity:connectivity": "pnpm -F backend identity:connectivity",
    "test:identity-operator": "node --test scripts/identity-operator.test.mjs",
    "build": "pnpm -F frontend build",
    "test": "pnpm -r test && pnpm test:identity-operator",
    "typecheck": "pnpm -r typecheck",
    "data:parkings": "node scripts/fetch-osm-parkings.mjs",
    "data:city": "node scripts/fetch-city-data.mjs",
    "data:osm-places": "node scripts/fetch-osm-places.mjs",
    "data:schools": "node scripts/fetch-osm-schools.mjs",
    "data:demo-routes": "node scripts/fetch-demo-routes.mjs",
    "data:osm-pois": "node scripts/fetch-osm-pois.mjs"
  }
}
