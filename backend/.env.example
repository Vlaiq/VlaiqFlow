# Copy to backend/.env and fill in. Never commit .env.
API_PORT=8787

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# openrouteservice (routing, matrix, geocoding) — https://openrouteservice.org/dev/#/signup
# Preferred provider. If empty: driving uses the OSRM public demo, walking/cycling the FOSSGIS OSRM server (1 req/s, cached).
# In managed cloud Node 24, enable inherited proxy support with NODE_USE_ENV_PROXY=1.
ORS_API_KEY=

# Optional integrations (P2) — the app must work without them
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# FLOW Voice uses a server-pinned agent/version and Mirela; clients cannot override them.
# The key must belong to the ElevenLabs workspace that owns the FLOW agent (shared/src/flowVoice.ts);
# a key from another account is refused and FLOW Voice says so. Restart the backend after setting it.
# Permit https://api.elevenlabs.io on the backend; WebRTC clients also need ElevenLabs/LiveKit access.
# CORS_ORIGINS must include the exact HTTPS frontend origin in production.
# HTTP navigation TTS requests use enable_logging=false; accounts without that capability fall back to browser speech.

# Tiger Cloud / Postgres connection string (not needed for P0)
DATABASE_URL=
